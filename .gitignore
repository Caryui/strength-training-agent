# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 运行时数据（用户的本地打卡记录，不入库）
data/*.json

# 日志
*.log
npm-debug.log*

# 环境变量（含密钥）
.env
.env.local
.env.*.local

# 编辑器 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
dump*.py
req_*.json
empty_*.json
prof.json
seed_*.json

# 本地 tsc 编译产物（不应入库，且会 shadow 真实 .ts 源）
server/*.js
server/*.d.ts
